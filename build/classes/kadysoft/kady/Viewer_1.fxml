<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@cupertino-light.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kadysoft.kady.ViewerController_1">
   <top>
      <HBox alignment="CENTER" prefHeight="59.0" prefWidth="1521.0" spacing="50.0" BorderPane.alignment="CENTER">
         <children>
            <JFXButton fx:id="seepilot" buttonType="RAISED" onAction="#seepilotaction" prefHeight="37.0" prefWidth="93.0" style="-fx-background-color: #ff0a54; -fx-font-weight: bold; -fx-background-radius: 3em; -fx-text-fill: white;" text="See Pilots">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </JFXButton>
            <JFXButton fx:id="getallbtn" buttonType="RAISED" onAction="#getallaction" prefHeight="37.0" prefWidth="93.0" style="-fx-background-radius: 3em; -fx-background-color: #ff0a54; -fx-text-fill: WHITE;" text="Get All" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="editorprint" buttonType="RAISED" onAction="#editorprintaction" prefHeight="37.0" prefWidth="93.0" style="-fx-background-radius: 5em; -fx-background-color: #ff0a54;">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </JFXButton>
            <JFXTextArea fx:id="coode" prefHeight="52.0" prefWidth="30.0" visible="false" />
            <Label alignment="CENTER" style="-fx-background-color: #ff0a54; -fx-background-radius: 3em; -fx-font-weight: bold; -fx-text-fill: white;" text="Created By Kadysoft Ltd, CEO : Ahmed Elkady" />
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="BOTTOM_LEFT" prefHeight="23.0" prefWidth="1521.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="tablee" onMouseClicked="#tableeaction" style="-fx-font-weight: bold;" text="Open As Table" underline="true">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Label>
            <Label fx:id="image" onMouseClicked="#imageaction" style="-fx-font-weight: bold;" text="Open As Image" underline="true">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Label>
            <Hyperlink fx:id="link" onAction="#linkaction" prefHeight="29.0" prefWidth="450.0" style="-fx-font-size: 15; -fx-font-weight: bold;" text="T &amp; C Garments" visible="false" />
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="table" onMouseClicked="#tableaction" prefHeight="599.0" prefWidth="1521.0" style="-fx-font-size: 15; -fx-font-weight: bold;" tableMenuButtonVisible="true" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
