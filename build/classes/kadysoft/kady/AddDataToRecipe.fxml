<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="839.0" prefWidth="1269.0" stylesheets="@cupertino-dark.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kadysoft.kady.AddDataToRecipeController">
   <center>
      <WebView fx:id="webview" prefHeight="778.0" prefWidth="1269.0" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="1269.0" spacing="25.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <JFXButton fx:id="push" buttonType="RAISED" onAction="#pushaction" prefHeight="32.0" prefWidth="65.0" style="-fx-background-color: #7543e3; -fx-font-weight: bold; -fx-background-radius: 3em; -fx-font-size: 13px;" text="Push">
               <effect>
                  <DropShadow />
               </effect>
            </JFXButton>
            <JFXButton fx:id="pull" buttonType="RAISED" layoutX="20.0" layoutY="25.0" onAction="#pullaction" prefHeight="32.0" prefWidth="65.0" style="-fx-background-color: #7543e3; -fx-font-weight: bold; -fx-background-radius: 3em; -fx-font-size: 13px;" text="Pull">
               <effect>
                  <DropShadow />
               </effect>
            </JFXButton>
         </children>
      </HBox>
   </bottom>
</BorderPane>
