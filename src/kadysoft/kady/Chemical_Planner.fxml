                              <JFXButton fx:id="delsel" buttonType="RAISED" onAction="#delselaction" prefHeight="36.0" prefWidth="109.0" style="-fx-background-color: #358f80; -fx-background-radius: 3em; -fx-font-weight: bold;" text="Del Selected">
