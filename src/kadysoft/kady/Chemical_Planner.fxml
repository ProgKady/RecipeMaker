                  <Menu fx:id="recentfiles" disable="true" mnemonicParsing="false" text="Recent files" />
                  <MenuItem fx:id="savetodb" disable="true" mnemonicParsing="false" onAction="#savetodbaction" text="Save Data To DataBase" />
                  <Menu fx:id="exporttomenu" disable="true" mnemonicParsing="false" text="Export To ...">
