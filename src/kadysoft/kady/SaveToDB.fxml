<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTabPane?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="594.0" prefWidth="915.0" stylesheets="@cupertino-light.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kadysoft.kady.SaveToDBController">

   <children>
      <JFXTabPane layoutX="14.0" layoutY="14.0" prefHeight="567.0" prefWidth="885.0">
         <tabs>
            
            <!-- Single File -->
            <Tab text="Single File (Dangerous)">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="520.0" prefWidth="880.0">
                     <children>
                        <JFXTextField fx:id="s1" layoutX="40.0" layoutY="71.0" prefHeight="32.0" prefWidth="440.0" promptText="Choose Encrypted File ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXButton buttonType="RAISED" layoutX="574.0" layoutY="73.0" onAction="#sb1action" style="-fx-font-weight: bold; -fx-background-color: #e0aaff; -fx-background-radius: 15;" text="Browse" />
                        
                        <JFXPasswordField fx:id="s2" layoutX="40.0" layoutY="170.0" prefHeight="32.0" prefWidth="440.0" promptText="Write Old Password ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXPasswordField fx:id="s3" layoutX="40.0" layoutY="266.0" prefHeight="32.0" prefWidth="440.0" promptText="Write New Password ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXButton buttonType="RAISED" layoutX="373.0" layoutY="366.0" onAction="#sb2action" style="-fx-font-weight: bold; -fx-background-color: #b5e48c; -fx-background-radius: 15;" text="Change Password" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            
            <!-- Multi Files -->
            <Tab text="Multi Files (Dangerous)">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="520.0" prefWidth="880.0">
                     <children>
                        <JFXTextField fx:id="m1" layoutX="28.0" layoutY="78.0" prefHeight="32.0" prefWidth="440.0" promptText="Choose Folder ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXButton buttonType="RAISED" layoutX="605.0" layoutY="78.0" onAction="#mb1action" style="-fx-font-weight: bold; -fx-background-color: #e0aaff; -fx-background-radius: 15;" text="Browse" />
                        
                        <JFXPasswordField fx:id="m2" layoutX="28.0" layoutY="175.0" prefHeight="32.0" prefWidth="440.0" promptText="Old Password ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXPasswordField fx:id="m3" layoutX="28.0" layoutY="273.0" prefHeight="32.0" prefWidth="440.0" promptText="New Password ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXButton buttonType="RAISED" layoutX="369.0" layoutY="366.0" onAction="#mb2action" style="-fx-font-weight: bold; -fx-background-color: #b5e48c; -fx-background-radius: 15;" text="Upgrade Password" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            
            <!-- Change Master Key -->
            <Tab text="Change Master Key (Good For All)">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="520.0" prefWidth="880.0">
                     <children>
                        
                        <JFXTextField fx:id="oldMasterKey" layoutX="50.0" layoutY="120.0" prefHeight="40.0" prefWidth="500.0" promptText="Long Code dat Old ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXPasswordField fx:id="newMasterKey" layoutX="50.0" layoutY="200.0" prefHeight="40.0" prefWidth="500.0" promptText="Long Code dat New ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        
                        <JFXButton fx:id="btnChangeMaster" layoutX="50.0" layoutY="280.0" onAction="#changeMasterPasswordAction" prefHeight="45.0" prefWidth="500.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15;" text="Change dat And Update All Files" />
                        <JFXTextField fx:id="m11" layoutX="50.0" layoutY="38.0" prefHeight="32.0" prefWidth="500.0" promptText="Choose Folder ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                        <JFXButton buttonType="RAISED" layoutX="682.0" layoutY="38.0" onAction="#mb11action" style="-fx-font-weight: bold; -fx-background-color: #e0aaff; -fx-background-radius: 15;" text="Browse" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            
            <!-- Tools -->
            <Tab text="Tools">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="520.0" prefWidth="880.0">
                     <children>
                        <JFXButton buttonType="RAISED" layoutX="370.0" layoutY="202.0" onAction="#codexaction" style="-fx-font-weight: bold; -fx-background-color: #e0aaff; -fx-background-radius: 15;" text="Generate New Key" />
                        
                        <JFXTextField fx:id="codex" layoutX="223.0" layoutY="266.0" prefHeight="32.0" prefWidth="440.0" promptText="Code Goes Here ..." style="-jfx-focus-color: transparent; -jfx-unfocus-color: transparent; -fx-background-radius: 15; -fx-font-weight: bold;" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            
         </tabs>
      </JFXTabPane>
   </children>
</AnchorPane>
